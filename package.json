{
  "name": "solstice",
  "version": "0.1.0",
  "description": "Open-source all-in-one productivity and creativity suite",
  "main": "dist/main/index.js",
  "scripts": {
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "dev:renderer": "vite",
    "build:renderer": "tsc -b && vite build",
    "build:electron": "esbuild src/main/index.ts --bundle --platform=node --target=node20 --outfile=dist/main/index.js --external:electron && esbuild src/preload/index.ts --bundle --platform=node --target=node20 --outfile=dist/preload/index.js --external:electron",
    "dev": "npm run build:electron && concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development ELECTRON_OZONE_PLATFORM_HINT=x11 electron . --ozone-platform=x11\"",
    "start": "cross-env ELECTRON_OZONE_PLATFORM_HINT=x11 electron . --ozone-platform=x11",
    "test": "npm run build && npx esbuild src/main/test-runner.ts --bundle --platform=node --target=node20 --outfile=dist/main/test-runner.js --external:electron && ./node_modules/.bin/electron dist/main/test-runner.js --no-sandbox --disable-gpu",
    "build": "npm run build:renderer && npm run build:electron"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@pdfsmaller/pdf-encrypt": "^1.2.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-shell": "^2.6.0",
    "@tiptap/extension-color": "^3.32.0",
    "@tiptap/extension-font-family": "^3.32.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-table-cell": "^3.32.0",
    "@tiptap/extension-table-header": "^3.32.0",
    "@tiptap/extension-table-row": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/extension-underline": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@xenova/transformers": "^2.17.2",
    "clsx": "^2.1.1",
    "docx": "^9.13.0",
    "lucide-react": "^1.16.0",
    "mammoth": "^1.13.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "tiptap-pagination-plus": "^3.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.8.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "esbuild": "^0.24.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "wait-on": "^8.0.1"
  }
}
